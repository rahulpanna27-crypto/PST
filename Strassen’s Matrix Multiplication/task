import java.io.*;
import java.math.*;
import java.security.*;
import java.text.*;
import java.util.*;
import java.util.concurrent.*;
import java.util.regex.*;

class Result {

    public static void matrixRotation(List<List<Integer>> matrix, int r) {
        int m = matrix.size();
        int n = matrix.get(0).size();
        int layers = Math.min(m, n) / 2;

        for (int k = 0; k < layers; k++) {
            List<Integer> ring = new ArrayList<>();

            int top = k;
            int bottom = m - 1 - k;
            int left = k;
            int right = n - 1 - k;

            // Top row: left to right
            for (int j = left; j <= right; j++) {
                ring.add(matrix.get(top).get(j));
            }
            // Right column: top+1 to bottom
            for (int i = top + 1; i <= bottom; i++) {
                ring.add(matrix.get(i).get(right));
            }
            // Bottom row: right-1 to left
            for (int j = right - 1; j >= left; j--) {
                ring.add(matrix.get(bottom).get(j));
            }
            // Left column: bottom-1 to top+1
            for (int i = bottom - 1; i > top; i--) {
                ring.add(matrix.get(i).get(left));
            }

            int len = ring.size();
            int shift = r % len;
            int idx = 0;

            // Write back top row
            for (int j = left; j <= right; j++) {
                matrix.get(top).set(j, ring.get((idx + shift) % len));
                idx++;
            }
            // Write back right column
            for (int i = top + 1; i <= bottom; i++) {
                matrix.get(i).set(right, ring.get((idx + shift) % len));
                idx++;
            }
            // Write back bottom row
            for (int j = right - 1; j >= left; j--) {
                matrix.get(bottom).set(j, ring.get((idx + shift) % len));
                idx++;
            }
            // Write back left column
            for (int i = bottom - 1; i > top; i--) {
                matrix.get(i).set(left, ring.get((idx + shift) % len));
                idx++;
            }
        }

        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                sb.append(matrix.get(i).get(j));
                if (j != n - 1) {
                    sb.append(" ");
                }
            }
            sb.append("\n");
        }
        System.out.print(sb.toString());
    }
}

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader bufferedReader = new BufferedReader(new InputStreamReader(System.in));

        String[] firstMultipleInput = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");

        int m = Integer.parseInt(firstMultipleInput[0]);
        int n = Integer.parseInt(firstMultipleInput[1]);
        int r = Integer.parseInt(firstMultipleInput[2]);

        List<List<Integer>> matrix = new ArrayList<>();

        for (int i = 0; i < m; i++) {
            String[] matrixRowTempItems = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");
            List<Integer> matrixRowItems = new ArrayList<>();
            for (int j = 0; j < n; j++) {
                matrixRowItems.add(Integer.parseInt(matrixRowTempItems[j]));
            }
            matrix.add(matrixRowItems);
        }

        Result.matrixRotation(matrix, r);

        bufferedReader.close();
    }
}

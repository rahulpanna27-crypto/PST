class Solution {
    public boolean halvesAreAlike(String s) {
        String vowels = "aeiouAEIOU";
        int vowelCount = 0;
        int mid = s.length() / 2;
        
        for (int i = 0; i < mid; i++) {
            char a = s.charAt(i);
            char b = s.charAt(mid + i);
            
            if (vowels.indexOf(a) != -1) {
                vowelCount++;
            }
            if (vowels.indexOf(b) != -1) {
                vowelCount--;
            }
        }
        
        return vowelCount == 0;
    }
}
